# Copy to ~/.blinkbox-bot/.env (or $BLINKBOX_BOT_DATA/.env) and fill in.
# The bot reads this file at start. Keep it chmod 600 and out of git.

# Required: from @BotFather
TELEGRAM_BOT_TOKEN=

# Naira on/off-ramp. Leave empty to run in test mode (real rates, no real orders).
PAYCREST_API_KEY=

# Optional
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org
ARC_RPC_URL=https://rpc.mainnet.arc.io
# Also: ETHEREUM_RPC_URL, ARBITRUM_RPC_URL, OPTIMISM_RPC_URL, POLYGON_RPC_URL,
# BNB_RPC_URL, AVALANCHE_RPC_URL, HYPEREVM_RPC_URL, ROBINHOOD_RPC_URL (public defaults built in)
JUPITER_API_KEY=        # turns on prediction-market betting
GROQ_API_KEY=           # turns on photo-to-pay and voice notes
GROQ_VISION_MODEL=      # default qwen/qwen3.8-27b
GROQ_STT_MODEL=         # default whisper-large-v3-turbo
GROQ_TEXT_MODEL=        # default llama-3.3-70b-versatile
